# ===== 对话 / 多模态 =====
# 引导默认（设置页「添加供应商」产生的多供应商实例优先于此处）：
# qwen / deepseek / moonshot / zhipu / minimax / ark / siliconflow；留空 = 未配置（相关操作 503 引导）
LLM_PROVIDER=

# 千问 MaaS 的 Key 存在 QWEN_API_KEY（与百炼不通用）；方言预设的覆盖项：填了即为准（换到未收录的 OpenAI 兼容服务商也只改这几项）
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_VISION_MODEL=

# 千问（Qwen MaaS 官方平台，maas.qianwenaiapi.com）：LLM + 多模态 + Embedding
QWEN_API_KEY=

# 录音转写：paraformer（阿里云百炼服务，需要专门的百炼 Key；千问 MaaS 不提供）
ASR_PROVIDER=
ASR_API_KEY=

# DeepSeek（省钱备选，OpenAI 兼容对话 + 多模态：deepseek-flash / deepseek-v4-pro）
# embedding 走下方 SiliconFlow，未配置时用本地确定性兜底向量（检索质量降级）
DEEPSEEK_API_KEY=

# Kimi（月之暗面，OpenAI 兼容对话）
MOONSHOT_API_KEY=

# 智谱 GLM（OpenAI 兼容对话 + 多模态 glm-4.5v + embedding-3）
ZHIPU_API_KEY=

# MiniMax（OpenAI 兼容对话）
MINIMAX_API_KEY=

# 豆包（字节火山方舟，OpenAI 兼容；模型 ID 也接受 ep- 接入点）
ARK_API_KEY=

# SiliconFlow（对话方言之一 + embedding 备选，托管 bge-large-zh）
SILICONFLOW_API_KEY=

# ===== 向量化（独立于对话 provider）=====
# 留空 = 跟随默认供应商实例的方言；可显式 hash / openai / qwen / siliconflow
EMBEDDING_PROVIDER=
# EMBEDDING_PROVIDER=openai 时的三件套（任何 OpenAI 兼容 /embeddings 服务商）
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# >0 时随请求发送（千问 text-embedding-v3 支持 1024/768/512）
EMBEDDING_DIMENSIONS=0

# MinerU PDF 解析（云端 API token，注册 mineru.net 获取）
MINERU_TOKEN=

# PDF 解析策略：mineru（仅云端）/ pypdf（仅本地）/ mineru_then_pypdf（默认，云端失败退本地）
PDF_STRATEGY=mineru_then_pypdf

# 博查网络搜索（留空 SEARCH_PROVIDER = 有 key 走 bocha，否则未配置 503 引导）
BOCHA_API_KEY=
SEARCH_PROVIDER=

# ===== RAG 策略（ADR-0003，票 03）=====
# 分块策略：paragraph（默认，按段落/标题边界合并 + 相邻重叠）
CHUNK_STRATEGY=paragraph
# 检索策略：vector_graph（默认，向量 + 图谱邻接融合）/ vector（纯向量，不带图谱段）
RETRIEVAL_STRATEGY=vector_graph

# ===== 数据库 =====
DATABASE_URL=sqlite:///./edumind.db

# ===== 任务级模型（CONTEXT.md「任务级模型」）=====
# 按任务分别选「供应商实例 + 模型档位」；供应商实例在设置页「添加供应商」产生（id），
# 留空 = 回落全局默认（默认实例的默认模型）。设置库优先于本文件，改完即时生效。
TASK_PROVIDER_INTENT=
TASK_MODEL_INTENT=
TASK_PROVIDER_GENERATE=
TASK_MODEL_GENERATE=
TASK_PROVIDER_CONFLICT=
TASK_MODEL_CONFLICT=
