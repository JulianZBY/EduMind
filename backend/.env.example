# ===== 对话 / 多模态 =====
# OpenAI 兼容方言：stub（默认，无 key 可跑通骨架）/ dashscope / deepseek / siliconflow
LLM_PROVIDER=stub

# 方言预设的覆盖项：填了即为准（换到未收录的 OpenAI 兼容服务商也只改这几项）
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_VISION_MODEL=

# 阿里云百炼（DashScope）：LLM + 多模态 + Embedding + paraformer
DASHSCOPE_API_KEY=

# 录音转写：stub（默认，无 key 可跑）/ paraformer（阿里百炼录音文件识别，复用 DASHSCOPE_API_KEY）
ASR_PROVIDER=stub

# DeepSeek（省钱备选，OpenAI 兼容对话；不支持图片/视频理解）
# embedding 走下方 SiliconFlow，未配置时用本地确定性兜底向量（检索质量降级）
DEEPSEEK_API_KEY=

# SiliconFlow（对话方言之一 + embedding 备选，托管 bge-large-zh）
SILICONFLOW_API_KEY=

# ===== 向量化（独立于对话 provider）=====
# 留空 = 跟随 LLM_PROVIDER 方言（stub→stub / dashscope→text-embedding-v3 /
# deepseek→硅基流动（无 key 退本地 hash））；可显式 stub / hash / openai / dashscope / siliconflow
EMBEDDING_PROVIDER=
# EMBEDDING_PROVIDER=openai 时的三件套（任何 OpenAI 兼容 /embeddings 服务商）
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
# >0 时随请求发送（dashscope text-embedding-v3 支持 1024/768/512）
EMBEDDING_DIMENSIONS=0

# MinerU PDF 解析（云端 API token，注册 mineru.net 获取）
MINERU_TOKEN=

# PDF 解析策略：mineru（仅云端）/ pypdf（仅本地）/ mineru_then_pypdf（默认，云端失败退本地）
PDF_STRATEGY=mineru_then_pypdf

# 博查网络搜索（留空 SEARCH_PROVIDER = 有 key 走 bocha，否则 stub 占位结果）
BOCHA_API_KEY=
SEARCH_PROVIDER=

# ===== RAG 策略（ADR-0003，票 03）=====
# 分块策略：paragraph（默认，按段落/标题边界合并 + 相邻重叠）
CHUNK_STRATEGY=paragraph
# 检索策略：vector_graph（默认，向量 + 图谱邻接融合）/ vector（纯向量，不带图谱段）
RETRIEVAL_STRATEGY=vector_graph

# ===== 数据库 =====
DATABASE_URL=sqlite:///./edumind.db
